+static int VoxelVoxelInternalAxisFallbackPin( void )
+{
+	b3Vec3i cellsA[] = { { 0, 0, 0 }, { 1, 0, 0 } };
+	b3Vec3i cellB = { 0, 0, 0 };
+	TestVoxelSolid solidA = {
+		cellsA,
