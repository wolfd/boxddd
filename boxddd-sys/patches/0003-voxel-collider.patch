+} TestVoxelSolid;
+
+bool TestCellEqual( b3Vec3i a, b3Vec3i b );
+bool TestSolidContainsCell( const TestVoxelSolid* solid, b3Vec3i cell );
+b3Vec3 TestCellCenter( const TestVoxelSolid* solid, b3Vec3i cell );
