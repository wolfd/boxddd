+typedef struct b3VoxelCanonicalContext
+{
+	const b3VoxelData* voxels0;
+	const b3VoxelData* voxels1;
+	b3Transform transform0;
+	b3Transform transform1;
+	b3Transform transform0To1;
+	b3Transform transform1To0;
+	b3Vec3 origin0;
+	b3Vec3 origin1;
