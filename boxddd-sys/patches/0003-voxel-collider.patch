+	};
+	b3Transform transformB = { { 1.29437864f, -0.0273844283f, 0.0140851848f }, b3Quat_identity };
+	ENSURE( TestRunVoxelPair( &solidA, b3Transform_identity, &solidB, transformB, true, b3Vec3_zero, false ) == 0 );
+	return 0;
+}
