+	b3Shape sphere = { .type = b3_sphereShape, .sphere = { b3Vec3_zero, 0.35f } };
+	b3Transform sphereToVoxel = { { -0.45f, 0.0f, 0.0f }, b3Quat_identity };
+	ENSURE( TestDiscreteConvexCase( &solid, &sphere, sphereToVoxel, true ) == 0 );
+	return 0;
+}
