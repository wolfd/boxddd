+static uint32_t HashBytes( uint32_t h, const void* data, size_t bytes )
+{
+	const uint8_t* p = (const uint8_t*)data;
+	for ( size_t i = 0; i < bytes; ++i )
+	{
+		h ^= p[i];
+		h *= 16777619u; // FNV-1a
+	}
+	return h;
+}
